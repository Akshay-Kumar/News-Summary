# ==============================
# 🌐 Domain & SSL (Traefik)
# ==============================
DOMAIN=yourdomain.com
EMAIL=your-email@example.com

# ==============================
# 🗄️ Database
# ==============================
# Local Docker Mongo (default)
MONGO_URI=mongodb://mongo:27017/newsdb

# OR MongoDB Atlas (uncomment and replace)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/newsdb

# ==============================
# 🔑 External API Keys
# ==============================
# Comma-separated keys supported
WORLDNEWS_API_KEYS=key1,key2,key3

# ==============================
# 🔐 Security
# ==============================
JWT_SECRET=change_this_to_a_strong_secret

# ==============================
# ⚙️ Server
# ==============================
PORT=5000
