#!/usr/bin/env node
// backend/bin/www
// --- Logging Setup ---
const fs = require("fs");

const logFile = fs.createWriteStream("app.log", { flags: "a" }); // append mode
const logStdout = process.stdout;

console.log = function (...args) {
  const timestamp = new Date().toISOString();
  const message = `[${timestamp}] ${args.join(" ")}\n`;

  logFile.write(message);   // save to file
  logStdout.write(message); // still print in terminal
};

console.error = function (...args) {
  const timestamp = new Date().toISOString();
  const message = `[${timestamp}] ERROR: ${args.join(" ")}\n`;

  logFile.write(message);
  logStdout.write(message);
};

const app = require('../app');
const http = require('http');
const connectDB = require('../utils/db');
const refreshNews = require('../jobs/refreshNews');

// Safe startup
(async () => {
  try {
    // Connect to MongoDB
    await connectDB();

    const port = process.env.PORT || 5000;
    app.set('port', port);
    const server = http.createServer(app);

    server.listen(port, () => {
      console.log(`Server running on port ${port}`);
    });
    await refreshNews();
  } catch (err) {
    console.error('Failed to start server:', err);
    process.exit(1);
  }
})();


